{
  "name": "cnysong",
  "version": "0.1.0",
  "description": "Floating, pinnable synced-lyrics window with romanization for Spotify",
  "main": "main.js",
  "author": "Tasha",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "test": "node test/smoke.js",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "hangul-romanization": "^1.0.1",
    "kuroshiro": "^1.2.1",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "pinyin-pro": "^3.29.5",
    "transliteration": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.example.cnysong",
    "productName": "CnySong",
    "directories": { "output": "dist" },
    "files": ["**/*", "!test/**", "!scripts/**", "!dist/**", "!.github/**", "!*.md"],
    "asarUnpack": ["node_modules/kuromoji/dict/**"],
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icon.png",
      "identity": null,
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "CnySong reads the current track and playback position from the Spotify app."
      }
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    }
  }
}
